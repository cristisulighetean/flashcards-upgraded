# LLM Provider Config (Groq)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama3-8b-8192
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Database Config (Postgres)
# These are used by both docker-compose and the FastAPI app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flashcards

# Vocabulary decks
# The word lists in data/*.csv are loaded 500 words at a time, commonest
# first. Deployment loads this many batches per deck; the rest are pulled in
# from the Vocabulary screen when you are ready for them.
SEED_VOCAB_ON_STARTUP=true
SEED_VOCAB_BATCHES=1
SEED_VOCAB_LANGS=en,ro
SEED_VOCAB_STATUS=pending

# Deployment Config
# Replace with your domain for Caddy
DOMAIN=flashcards.local
