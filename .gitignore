# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.local

# Databases — the app runs on Postgres now (see docker-compose.yml's `db`
# service). flashcards.db is deliberately kept as the pre-migration snapshot,
# not a live file docker-compose mounts anymore.
*.db
*.sqlite
*.sqlite3
!flashcards.db

